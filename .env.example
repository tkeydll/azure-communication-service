# Azure Communication Service Configuration
COMMUNICATION_SERVICES_CONNECTION_STRING=your_connection_string_here

# Phone Numbers
FROM_PHONE_NUMBER=+1234567890
TO_PHONE_NUMBER=+0987654321

# API Server Configuration
PORT=3000
CALLBACK_URL=https://your-public-host.example.com/api/CallEvents
# For the deployed Function App, use https://<host>/api/CallEvents?code=<CallEvents function key>
CALLBACK_FUNCTION_KEY=your_call_events_function_key
GETAUDIO_FUNCTION_KEY=your_get_audio_function_key

# Optional: Azure Resource Configuration
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_RESOURCE_GROUP=your_resource_group
AZURE_COMMUNICATION_SERVICE_NAME=your_acs_name
